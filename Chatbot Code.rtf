// chatgpt.js\
require('dotenv').config();\
const express = require('express');\
const bodyParser = require('body-parser');\
const \{ Configuration, OpenAIApi \} = require('openai');\
const app = express();\
const port = 3001; // or any available portp\
\
app.use(bodyParser.json());\
app.use(express.static('public')); // serve frontend files from /public\
\
const configuration = new Configuration(\{\
  apiKey: process.env.OPENAI_API_KEY,\
\});\
const openai = new OpenAIApi(configuration);\
\
// API route\
app.post('/api/risk-insight', async (req, res) => \{\
  const \{ city \} = req.body;\
\
  try \{\
    const prompt = `Our Risk Radar project analyzes city-level risks. Based on our dataset, give me a short summary of current risks or challenges in $\{city\}. Focus on climate, disaster, or socioeconomic risks if relevant.`;\
\
    const completion = await openai.createChatCompletion(\{\
      model: 'gpt-3.5-turbo', // or 'gpt-4'\
      messages: [\{ role: 'user', content: prompt \}],\
      temperature: 0.7,\
    \});\
\
    const reply = completion.data.choices[0].message.content;\
    res.json(\{ message: reply \});\
  \} catch (error) \{\
    console.error('OpenAI Error:', error.response?.data || error.message);\
    res.status(500).json(\{ error: 'Error fetching response from ChatGPT' \});\
  \}\
\});\
\
app.listen(port, () => \{\
  console.log(`Server listening on http://localhost:$\{port\}`);\
\});\
\
